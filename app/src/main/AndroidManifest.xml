<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Pedeef asks for no permissions at all: the scanner runs in Google Play services, OCR runs on-device, and
       files move through the system file picker, so there is nothing to grant and nothing to leak. -->
  <queries>
    <intent>
      <action android:name="android.intent.action.VIEW" />
      <data android:mimeType="application/pdf" />
    </intent>
  </queries>

  <application
    android:allowBackup="false"
    android:icon="@mipmap/ic_launcher"
    android:roundIcon="@mipmap/ic_launcher_round"
    android:label="Pedeef"
    android:supportsRtl="true"
    android:enableOnBackInvokedCallback="false"
    android:theme="@style/AppTheme">

    <activity
      android:name=".MainActivity"
      android:exported="true"
      android:launchMode="singleTask"
      android:screenOrientation="portrait"
      android:windowSoftInputMode="adjustResize">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>

    <!-- Hands saved files to PDF viewers and the share sheet as content:// uris with read permission. -->
    <provider
      android:name="androidx.core.content.FileProvider"
      android:authorities="${applicationId}.files"
      android:exported="false"
      android:grantUriPermissions="true">
      <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
    </provider>
  </application>
</manifest>
